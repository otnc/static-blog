{
  "name": "static-blog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.32.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write ./src/ ./scripts/",
    "new": "node scripts/create-article.mjs",
    "thumbnail": "node scripts/edit-thumbnail.mjs",
    "file": "node scripts/upload-file.mjs",
    "comp": "node scripts/compress-files.mjs",
    "comp:all": "node scripts/compress-files.mjs --all",
    "force-comp": "node scripts/compress-files.mjs --force",
    "force-comp:all": "node scripts/compress-files.mjs --force --all",
    "size": "node scripts/file-size.mjs",
    "size:all": "node scripts/file-size.mjs --all",
    "date:pub": "node scripts/update-date.mjs pubDate",
    "date:publish": "node scripts/update-date.mjs pubDate",
    "date:updated": "node scripts/update-date.mjs updatedDate",
    "date:update": "node scripts/update-date.mjs updatedDate"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/material-symbols": "^1.2.92",
    "astro": "^7.3.3",
    "astro-icon": "^1.2.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "fs-extra": "^11.4.0",
    "gray-matter": "^4.0.3",
    "he": "^1.2.0",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^6.3.289",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.5.0",
    "@types/he": "^1.2.3",
    "@types/node": "^22.20.4",
    "cropperjs": "^1.6.3",
    "heic-convert": "^2.1.0",
