---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ShareButtons from "../components/ShareButtons.astro";
import ArticleNav from "../components/ArticleNav.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TableOfContents from "../components/TableOfContents.astro";
import AboutSidebar from "../components/AboutSidebar.astro";
import { getCollection, render } from "astro:content";
import { SITE_URL, sortPosts } from "../consts";
import he from "he";
import { findCustomThumbnailUrl } from "../utils/thumbnail";

interface Props {
  id: string;
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date | null;
  tags?: string[];
  heroImage?: string;
}

const {
  id,
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  heroImage,
} = Astro.props;

const ogImage = `/og/${id}.png`;
const thumbnail = findCustomThumbnailUrl(id);

const sortedTags = [...tags].sort((a, b) => a.localeCompare(b, "ja"));

// Get all posts for prev/next navigation
const allPosts = sortPosts(
  (await getCollection("blog")).filter((p) => !p.data.hidden),
);

const currentIndex = allPosts.findIndex((p) => p.id === id);
const prevPost =
  currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const articleUrl = `${SITE_URL}/article/${id}`;

// 読了時間（日本語: 約500文字/分）
const slotContent = await Astro.slots.render("default");
const textLength = slotContent.replace(/<[^>]*>/g, "").length;
const readingTime = Math.max(1, Math.ceil(textLength / 500));

// Extract h1-h3 headings for table of contents
const headingRegex = /<h([1-3])([^>]*)>([\s\S]*?)<\/h[1-3]>/gi;
const headings: { level: number; id: string; text: string }[] = [];
let headingMatch: RegExpExecArray | null;
while ((headingMatch = headingRegex.exec(slotContent)) !== null) {
  const [, level, attrs, rawHtml] = headingMatch;
  const idMatch = attrs.match(/\bid="([^"]*)"/);
  if (!idMatch) continue;
  const text = he.decode(rawHtml.replace(/<[^>]*>/g, "").trim());
  headings.push({ level: parseInt(level), id: idMatch[1], text });
}
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  article={true}
>
  <Header />
  <AboutSidebar />
  <main class="container">
    <article id="article-top">
      <header class="article-header">
        <h1 class="article-title">{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta">
          <span class="meta-item">
            <iconify-icon
              icon="material-symbols:calendar-today-outline"
              width="14"
              height="14"
              aria-hidden="true"></iconify-icon>
            <FormattedDate date={pubDate} />
          </span>
          {
            updatedDate && (
              <span class="meta-item">
                <iconify-icon
                  icon="material-symbols:update"
                  width="14"
                  height="14"
                  aria-hidden="true"
                />
                <FormattedDate date={updatedDate} />
              </span>
            )
          }
          <span class="meta-item reading-time">
            <iconify-icon
              icon="material-symbols:schedule-outline"
              width="14"
              height="14"
              aria-hidden="true"></iconify-icon>
            約{readingTime}分
          </span>
        </div>
        {
          sortedTags.length > 0 && (
            <div class="article-tags">
              {sortedTags.map((tag) => (
                <a href={`/tag/${tag}`} class="tag">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
        {
          thumbnail && (
            <img
              class="article-thumbnail"
              src={thumbnail}
              alt=""
              decoding="async"
              width="1200"
              height="630"
            />
          )
        }
      </header>

      <div class="article-content">
        <slot />
      </div>

      <ShareButtons url={articleUrl} title={title} />

      <ArticleNav
        prevPost={prevPost
          ? { id: prevPost.id, title: prevPost.data.title }
          : null}
        nextPost={nextPost
          ? { id: nextPost.id, title: nextPost.data.title }
          : null}
      />
    </article>
  </main>
  <Footer />

  <TableOfContents title={title} headings={headings} />

  <!-- TOC toggle -->
  <script>
    const tocBtn = document.getElementById(
      "action-toc-btn",
    ) as HTMLElement | null;
    tocBtn?.classList.add("enabled");
    tocBtn?.addEventListener("click", () => {
      const expanded = tocBtn.getAttribute("aria-expanded") === "true";
      if (expanded) {
        window.dispatchEvent(new Event("toc:close"));
        tocBtn.setAttribute("aria-expanded", "false");
      } else {
        window.dispatchEvent(new Event("toc:open"));
        tocBtn.setAttribute("aria-expanded", "true");
      }
    });
  </script>

  <!-- KaTeX fallback -->
  <script>
    async function initKatexFallback() {
      const articleRoot = document.querySelector(".article-content");
      if (!articleRoot) return;

      try {
        const { default: renderMathInElement } =
          // @ts-ignore
          await import("katex/dist/contrib/auto-render.mjs");
        renderMathInElement(articleRoot, {
          throwOnError: false,
          delimiters: [
            { left: "$$", right: "$$", display: true },
            { left: "\\[", right: "\\]", display: true },
            { left: "$", right: "$", display: false },
            { left: "\\(", right: "\\)", display: false },
          ],
        });
      } catch (err) {
        console.error("KaTeX fallback rendering error:", err);
      }
    }

    initKatexFallback();
  </script>

  <!-- Mermaid -->
  <script>
    async function initMermaid() {
      const mermaidElements =
        document.querySelectorAll<HTMLElement>("pre.mermaid");
      if (mermaidElements.length === 0) return;

      const { default: mermaid } = await import("mermaid");
      const theme = document.documentElement.getAttribute("data-theme");
      mermaid.initialize({
        startOnLoad: false,
        theme: theme === "dark" ? "dark" : "default",
        securityLevel: "loose",
        fontFamily: "inherit",
      });

      try {
        await mermaid.run({ nodes: mermaidElements });
      } catch (err) {
        console.error("Mermaid rendering error:", err);
      }
    }

    // Re-run on theme change
    function watchTheme() {
      const observer = new MutationObserver(() => {
        document
          .querySelectorAll("pre.mermaid[data-processed]")
          .forEach((el) => {
            el.removeAttribute("data-processed");
            const original = (el as HTMLElement).dataset.original;
            if (original) el.textContent = original;
          });
        initMermaid();
      });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }

    // Store original diagram source before mermaid replaces it
    document.querySelectorAll("pre.mermaid").forEach((el) => {
      (el as HTMLElement).dataset.original = el.textContent ?? "";
    });

    initMermaid().then(watchTheme);
  </script>

  <!-- Code copy buttons -->
  <script>
    function addCodeCopyButtons() {
      document.querySelectorAll("pre:not(.mermaid)").forEach((pre) => {
        if (pre.querySelector(".code-copy-btn")) return;
        const wrapper = document.createElement("div");
        wrapper.className = "code-block-wrapper";
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const btn = document.createElement("button");
        btn.className = "code-copy-btn";
        btn.setAttribute("aria-label", "コードをコピー");
        btn.innerHTML =
          '<iconify-icon icon="material-symbols:content-copy-outline" width="14" height="14"></iconify-icon> Copy';
        btn.addEventListener("click", async () => {
          const code =
            pre.querySelector("code")?.textContent || pre.textContent || "";
          try {
            await navigator.clipboard.writeText(code);
          } catch {
            const ta = document.createElement("textarea");
            ta.value = code;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            document.body.removeChild(ta);
          }
          btn.innerHTML =
            '<iconify-icon icon="material-symbols:check" width="14" height="14"></iconify-icon> Copied!';
          btn.classList.add("copied");
          setTimeout(() => {
            btn.innerHTML =
              '<iconify-icon icon="material-symbols:content-copy-outline" width="14" height="14"></iconify-icon> Copy';
            btn.classList.remove("copied");
          }, 2000);
        });
        wrapper.appendChild(btn);
      });
    }

    addCodeCopyButtons();
  </script>

  <!-- Wrap tables for horizontal scroll -->
  <script>
    document
      .querySelectorAll<HTMLElement>(".article-content table")
      .forEach((table) => {
        if (table.parentElement?.classList.contains("table-scroll")) return;
        const wrapper = document.createElement("div");
        wrapper.className = "table-scroll";
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      });
  </script>

  <!-- PDF viewer (PDF.js) -->
  <script>
    type PdfModule = typeof import("pdfjs-dist");
    let pdfjsPromise: Promise<PdfModule> | null = null;

    async function loadPdfjs(): Promise<PdfModule> {
      if (!pdfjsPromise) {
        pdfjsPromise = (async () => {
          const pdfjs = await import("pdfjs-dist");
          // Vite の ?worker import で dev/build 両対応の Worker を生成
          const { default: PdfWorker } = await import(
            // @ts-ignore - ?worker は Worker コンストラクタを返す
            "pdfjs-dist/build/pdf.worker.min.mjs?worker"
          );
          pdfjs.GlobalWorkerOptions.workerPort = new PdfWorker();
          return pdfjs;
        })();
      }
      return pdfjsPromise;
    }

    async function initPdfViewer(root: HTMLElement) {
      if (root.dataset.pdfInit) return;
      root.dataset.pdfInit = "1";

      const src = root.dataset.pdfSrc;
      if (!src) return;

      const toolbar = root.querySelector<HTMLElement>(".pdf-toolbar");
      const pagesEl = root.querySelector<HTMLElement>(".pdf-pages");
      const fallback = root.querySelector<HTMLElement>(".pdf-fallback");
      const indicator = root.querySelector<HTMLElement>(".pdf-page-indicator");
      const zoomInBtn = root.querySelector<HTMLButtonElement>(".pdf-zoom-in");
      const zoomOutBtn = root.querySelector<HTMLButtonElement>(".pdf-zoom-out");
      const modeBtn = root.querySelector<HTMLButtonElement>(".pdf-mode");
      const fsBtn = root.querySelector<HTMLButtonElement>(".pdf-fullscreen");
      if (!pagesEl) return;

      try {
        const pdfjs = await loadPdfjs();
        const pdf = await pdfjs.getDocument({ url: src }).promise;
        const numPages = pdf.numPages;

        type PageEntry = {
          pageNum: number;
          wrapper: HTMLElement;
          canvas: HTMLCanvasElement;
          viewportRatio: number; // height / width @ scale 1
          renderedW: number; // 直近に描画した CSS 幅 (0 = 未描画)
          rendering: boolean;
        };
        const entries: PageEntry[] = [];
        let zoom = 1;
        let currentPage = 1;
        let mode: "scroll" | "slide" = "scroll";

        // 表示を viewer モードに切り替え
        fallback?.setAttribute("hidden", "");
        toolbar?.removeAttribute("hidden");
        pagesEl.removeAttribute("hidden");
        root.classList.add("pdf-ready", "mode-scroll");

        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        // モード/ズーム/コンテナに応じたページの目標 CSS 幅
        function pageCssWidth(entry: PageEntry): number {
          const ratio = entry.viewportRatio;
          if (mode === "slide") {
            // 全体が収まるよう幅・高さ両方にフィット (contain)
            const cw = Math.max(120, pagesEl!.clientWidth - 24);
            const ch = Math.max(120, pagesEl!.clientHeight - 24);
            let w = cw;
            if (w * ratio > ch) w = ch / ratio;
            return w * zoom;
          }
          return Math.max(200, pagesEl!.clientWidth - 24) * zoom;
        }

        function setCanvasCss(entry: PageEntry) {
          const w = pageCssWidth(entry);
          entry.canvas.style.width = `${Math.floor(w)}px`;
          entry.canvas.style.height = `${Math.floor(w * entry.viewportRatio)}px`;
        }

        async function renderPage(entry: PageEntry) {
          const targetW = Math.floor(pageCssWidth(entry));
          if (entry.rendering || entry.renderedW === targetW) return;
          entry.rendering = true;
          try {
            const page = await pdf.getPage(entry.pageNum);
            const unscaled = page.getViewport({ scale: 1 });
            const scale = targetW / unscaled.width;
            const viewport = page.getViewport({ scale });

            const canvas = entry.canvas;
            const ctx = canvas.getContext("2d");
            if (!ctx) return;
            canvas.width = Math.floor(viewport.width * dpr);
            canvas.height = Math.floor(viewport.height * dpr);
            canvas.style.width = `${Math.floor(viewport.width)}px`;
            canvas.style.height = `${Math.floor(viewport.height)}px`;

            await page.render({
              canvas,
              canvasContext: ctx,
              viewport,
              transform: dpr !== 1 ? [dpr, 0, 0, dpr, 0, 0] : undefined,
            }).promise;
            entry.renderedW = targetW;
          } catch (err) {
            console.error("PDF page render error:", err);
          } finally {
            entry.rendering = false;
          }
        }

        // ページのプレースホルダ生成 (高さは比率から先に確保)
        for (let i = 1; i <= numPages; i++) {
          const page = await pdf.getPage(i);
          const vp = page.getViewport({ scale: 1 });
          const wrapper = document.createElement("div");
          wrapper.className = "pdf-page";
          wrapper.dataset.page = String(i);
          const canvas = document.createElement("canvas");
          wrapper.appendChild(canvas);
          pagesEl.appendChild(wrapper);
          const entry: PageEntry = {
            pageNum: i,
            wrapper,
            canvas,
            viewportRatio: vp.height / vp.width,
            renderedW: 0,
            rendering: false,
          };
          entries.push(entry);
          setCanvasCss(entry);
        }

        // ── 紙芝居モード用のナビゲーション矢印 (オーバーレイ) ──
        function makeNav(cls: string, label: string, icon: string) {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = `pdf-nav ${cls}`;
          btn.setAttribute("aria-label", label);
          btn.title = label;
          btn.innerHTML = `<iconify-icon icon="${icon}" width="20" height="20" aria-hidden="true"></iconify-icon>`;
          root.appendChild(btn);
          return btn;
        }
        const prevNav = makeNav(
          "pdf-nav-prev",
          "前のページ",
          "material-symbols:chevron-left",
        );
        const nextNav = makeNav(
          "pdf-nav-next",
          "次のページ",
          "material-symbols:chevron-right",
        );

        function updateIndicator() {
          if (indicator) indicator.textContent = `${currentPage} / ${numPages}`;
        }
        function updateNav() {
          prevNav.disabled = currentPage <= 1;
          nextNav.disabled = currentPage >= numPages;
        }

        function isNear(entry: PageEntry): boolean {
          const r = entry.wrapper.getBoundingClientRect();
          const pr = pagesEl!.getBoundingClientRect();
          return r.bottom > pr.top - 300 && r.top < pr.bottom + 300;
        }

        // 表示中 (+ 近接) のページのみ描画
        function renderVisible() {
          if (mode === "slide") {
            [currentPage - 2, currentPage - 1, currentPage].forEach((idx) => {
              const e = entries[idx];
              if (e) renderPage(e);
            });
          } else {
            entries.forEach((e) => {
              if (isNear(e)) renderPage(e);
            });
          }
        }

        // ── スクロールモードの現在ページ計算 (正確) ──
        let scrollRaf = 0;
        function computeScrollPage() {
          const mid = pagesEl!.scrollTop + pagesEl!.clientHeight * 0.4;
          let p = 1;
          for (const e of entries) {
            if (e.wrapper.offsetTop <= mid) p = e.pageNum;
            else break;
          }
          if (p !== currentPage) {
            currentPage = p;
            updateIndicator();
            updateNav();
          }
        }
        pagesEl.addEventListener("scroll", () => {
          if (mode !== "scroll" || scrollRaf) return;
          scrollRaf = requestAnimationFrame(() => {
            scrollRaf = 0;
            computeScrollPage();
            renderVisible();
          });
        });

        // ── レイアウト再計算 (リサイズ/ズーム/モード/全画面) ──
        let relayoutTimer: number | undefined;
        function relayout(immediate = false) {
          const run = () => {
            entries.forEach((e) => setCanvasCss(e));
            renderVisible();
          };
          if (immediate) {
            run();
            return;
          }
          window.clearTimeout(relayoutTimer);
          relayoutTimer = window.setTimeout(run, 150);
        }

        // ── ページ移動 ──
        function goTo(n: number) {
          currentPage = Math.min(numPages, Math.max(1, n));
          if (mode === "slide") {
            entries.forEach((e) => {
              e.wrapper.hidden = e.pageNum !== currentPage;
            });
            pagesEl!.scrollTop = 0;
            renderVisible();
          } else {
            const cur = entries[currentPage - 1];
            if (cur)
              pagesEl!.scrollTo({
                top: cur.wrapper.offsetTop,
                behavior: "smooth",
              });
          }
          updateIndicator();
          updateNav();
        }
        prevNav.addEventListener("click", () => goTo(currentPage - 1));
        nextNav.addEventListener("click", () => goTo(currentPage + 1));

        // ── モード切替 (スクロール ⇄ プレゼン) ──
        function setMode(next: "scroll" | "slide") {
          mode = next;
          root.classList.toggle("mode-slide", mode === "slide");
          root.classList.toggle("mode-scroll", mode === "scroll");
          if (modeBtn) {
            const label = mode === "slide" ? "スクロール表示" : "プレゼン表示";
            modeBtn
              .querySelector("iconify-icon")
              ?.setAttribute(
                "icon",
                mode === "slide"
                  ? "material-symbols:view-day-outline"
                  : "material-symbols:slideshow",
              );
            const labelEl = modeBtn.querySelector<HTMLElement>(".pdf-mode-label");
            if (labelEl) labelEl.textContent = label;
            modeBtn.setAttribute("aria-label", label);
            modeBtn.title = label;
          }
          entries.forEach((e) => {
            e.wrapper.hidden = mode === "slide" && e.pageNum !== currentPage;
          });
          relayout(true);
          if (mode === "scroll") {
            const cur = entries[currentPage - 1];
            if (cur) pagesEl!.scrollTop = cur.wrapper.offsetTop;
          }
          root.focus({ preventScroll: true });
        }
        modeBtn?.addEventListener("click", () =>
          setMode(mode === "slide" ? "scroll" : "slide"),
        );

        // ── 全画面 ──
        function toggleFullscreen() {
          if (document.fullscreenElement === root) {
            document.exitFullscreen?.();
          } else {
            root.requestFullscreen?.().catch(() => {});
          }
        }
        fsBtn?.addEventListener("click", toggleFullscreen);
        document.addEventListener("fullscreenchange", () => {
          const fs = document.fullscreenElement === root;
          root.classList.toggle("is-fullscreen", fs);
          fsBtn
            ?.querySelector("iconify-icon")
            ?.setAttribute(
              "icon",
              fs
                ? "material-symbols:fullscreen-exit"
                : "material-symbols:fullscreen",
            );
          // 全画面はプレゼン表示が見やすいので自動で切替
          if (fs && mode === "scroll") setMode("slide");
          requestAnimationFrame(() => relayout(true));
        });

        // ── ズーム ──
        function applyZoom(next: number) {
          zoom = Math.min(3, Math.max(0.5, next));
          entries.forEach((e) => setCanvasCss(e));
          relayout();
        }
        zoomInBtn?.addEventListener("click", () => applyZoom(zoom + 0.25));
        zoomOutBtn?.addEventListener("click", () => applyZoom(zoom - 0.25));

        // ── キーボード操作 ──
        root.tabIndex = 0;
        root.addEventListener("keydown", (e) => {
          if (mode === "slide" && (e.key === "ArrowRight" || e.key === "ArrowDown")) {
            goTo(currentPage + 1);
            e.preventDefault();
          } else if (
            mode === "slide" &&
            (e.key === "ArrowLeft" || e.key === "ArrowUp")
          ) {
            goTo(currentPage - 1);
            e.preventDefault();
          } else if (e.key === "f" || e.key === "F") {
            toggleFullscreen();
          }
        });

        // ── マウスホイール (紙芝居) ──
        let wheelLock = false;
        pagesEl.addEventListener(
          "wheel",
          (e) => {
            if (mode !== "slide" || zoom > 1) return;
            e.preventDefault(); // ページ全体のスクロールを抑止
            const delta = e.deltaY || e.deltaX;
            if (wheelLock || Math.abs(delta) < 4) return;
            wheelLock = true;
            goTo(currentPage + (delta > 0 ? 1 : -1));
            window.setTimeout(() => {
              wheelLock = false;
            }, 160);
          },
          { passive: false },
        );

        // ── スワイプ (紙芝居) ──
        let touchX = 0;
        let touchY = 0;
        pagesEl.addEventListener(
          "touchstart",
          (e) => {
            touchX = e.changedTouches[0].clientX;
            touchY = e.changedTouches[0].clientY;
          },
          { passive: true },
        );
        pagesEl.addEventListener(
          "touchend",
          (e) => {
            if (mode !== "slide" || zoom > 1) return;
            const dx = e.changedTouches[0].clientX - touchX;
            const dy = e.changedTouches[0].clientY - touchY;
            if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
              goTo(currentPage + (dx < 0 ? 1 : -1));
            }
          },
          { passive: true },
        );

        // ── リサイズ ──
        window.addEventListener("resize", () => relayout());

        // 初期描画
        updateIndicator();
        updateNav();
        relayout(true);
      } catch (err) {
        console.error("PDF viewer init error:", err);
        // 失敗時はフォールバックに戻し、全ボタン (ツールバー + ナビ矢印) を消す
        toolbar?.setAttribute("hidden", "");
        pagesEl.setAttribute("hidden", "");
        root.querySelectorAll(".pdf-nav").forEach((el) => el.remove());
        root.classList.remove("pdf-ready", "mode-scroll", "mode-slide");
        fallback?.removeAttribute("hidden");
      }
    }

    function setupPdfViewers() {
      const viewers =
        document.querySelectorAll<HTMLElement>(".pdf-viewer[data-pdf-src]");
      if (viewers.length === 0) return;
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              obs.unobserve(e.target);
              initPdfViewer(e.target as HTMLElement);
            }
          }
        },
        { rootMargin: "400px 0px" },
      );
      viewers.forEach((v) => io.observe(v));
    }

    setupPdfViewers();
  </script>

  <!-- Twitter embed -->
  <script
    is:inline
    async
    src="https://platform.twitter.com/widgets.js"
    charset="utf-8"></script>
</BaseLayout>
