---
import { tagFilterUrl } from "../utils/tag-url";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
const sorted = [...tags].sort((a, b) => a.localeCompare(b, "ja"));
---

{sorted.length > 0 && (
  <div class="card-tags">
    {sorted.map((tag) => (
      <a href={tagFilterUrl([tag])} class="tag card-tag">
        #{tag}
      </a>
    ))}
  </div>
)}
