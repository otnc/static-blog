---
import type { CollectionEntry } from "astro:content";
import PinnedBadge from "./PinnedBadge.astro";
import PostMeta from "./PostMeta.astro";
import PostTags from "./PostTags.astro";

interface Props {
  post: CollectionEntry<"blog">;
  /** カスタムサムネイルの URL */
  thumbnail?: string;
}

const { post, thumbnail } = Astro.props;
const { title, description, pubDate, updatedDate, tags, pinned } = post.data;
---

<article
  class:list={["article-card", { pinned, "has-thumbnail": Boolean(thumbnail) }]}
>
  {thumbnail && (
    <img
      class="card-thumbnail"
      src={thumbnail}
      alt=""
      loading="lazy"
      decoding="async"
      width="1200"
      height="630"
    />
  )}
  {pinned && <PinnedBadge />}
  <h2 class="card-title">
    <a href={`/article/${post.id}`} class="card-link">
      {title}
    </a>
  </h2>
  <p class="card-description">{description}</p>
  <PostMeta pubDate={pubDate} updatedDate={updatedDate} />
  <PostTags tags={tags} />
</article>
