---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import PageSection from "../components/PageSection.astro";
import PageHeading from "../components/PageHeading.astro";
import SearchBox from "../components/SearchBox.astro";
import TagFilter from "../components/TagFilter.astro";
import SortControls from "../components/SortControls.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { SITE_TITLE, SITE_DESCRIPTION, sortPosts } from "../consts";
import { findCustomThumbnailUrl } from "../utils/thumbnail";

type BlogPost = CollectionEntry<"blog">;

const allPosts: BlogPost[] = sortPosts(
  (await getCollection("blog")).filter((p) => !p.data.hidden),
);

// カスタムサムネイルが設定されている記事は、その URL を引けるようにする
const thumbnails = new Map<string, string>();
for (const post of allPosts) {
  const url = findCustomThumbnailUrl(post.id);
  if (url) thumbnails.set(post.id, url);
}

// Collect all tags with per-tag article counts
const tagCounts = new Map<string, number>();
allPosts.forEach((p) =>
  p.data.tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)),
);
const tags = [...tagCounts.keys()]
  .sort((a, b) => a.localeCompare(b, "ja"))
  .map((name) => ({ name, count: tagCounts.get(name) ?? 0 }));
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION} sidebar>
  <PageSection>
    <PageHeading icon="material-symbols:article-outline">記事一覧</PageHeading>

    <SearchBox />
    <TagFilter tags={tags} total={allPosts.length} />
    <SortControls />

    <p class="result-count" id="result-count" aria-live="polite">
      {allPosts.length}件の記事
    </p>

    <ul class="article-list" id="article-list">
      {allPosts.map((post) => (
        <li
          data-title={post.data.title.toLowerCase()}
          data-tags={post.data.tags.join(",").toLowerCase()}
          data-date={post.data.pubDate.getTime()}
          data-updated={
            post.data.updatedDate?.getTime() || post.data.pubDate.getTime()
          }
          data-pinned={post.data.pinned ? "true" : "false"}
        >
          <ArticleCard post={post} thumbnail={thumbnails.get(post.id)} />
        </li>
      ))}
    </ul>

    <p
      id="no-results"
      style="display: none; text-align: center; color: var(--text-muted); padding: 2em;"
    >
      <iconify-icon
        icon="material-symbols:search-off"
        width="24"
        height="24"
        aria-hidden="true"
      ></iconify-icon>
      <br />
      検索結果がありません
    </p>
  </PageSection>

  <script>
    import "../scripts/article-filter";
  </script>
</SiteLayout>
