---
// タグ別ページは廃止し、トップのタグ絞り込み (?tags=) に統合した。
// 共有済みの /tag/<タグ> のリンクを切らないよう、転送だけを行う。
import { getCollection } from "astro:content";
import { tagFilterUrl } from "../../utils/tag-url";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.hidden);
  const tags = new Set(posts.flatMap((p) => p.data.tags));
  return [...tags].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const to = tagFilterUrl([tag!]);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>転送中...</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>
      <a href={to}>タグ「{tag}」の記事一覧へ移動します</a>
    </p>
  </body>
</html>
