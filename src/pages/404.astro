---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="404 - ページが見つかりません">
  <div class="not-found">
    <h1>404</h1>
    <p>お探しのページは見つかりませんでした。</p>
    <a href="/">
      <iconify-icon
        icon="material-symbols:home-outline"
        width="18"
        height="18"
        aria-hidden="true"
      ></iconify-icon>
      トップページに戻る
    </a>
  </div>
</SiteLayout>
